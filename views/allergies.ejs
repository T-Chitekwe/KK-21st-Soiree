<%- include('_head') %>

<div class="stars-overlay"></div>

<main class="page-center">
  <div class="card card--question" role="main">

    <div class="card__ornament" aria-hidden="true"></div>

    <p class="card__eyebrow">Just a Few Questions</p>
    <h1 class="card__title">K <span class="amp">&amp;</span> K</h1>
    <p class="card__subtitle">21st Soirée</p>

    <div class="card__divider" aria-hidden="true">
      <div class="card__divider-line"></div>
      <div class="card__divider-diamond"></div>
      <div class="card__divider-line"></div>
    </div>

    <p class="card__step">Step 1 of 2</p>
    <p class="card__question">Do you have any food allergies or dietary requirements?</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert--error" role="alert"><%= error %></div>
    <% } %>

    <div class="allergy-choices">
      <button class="allergy-btn allergy-btn--yes" onclick="showAllergyInput()">
        <span class="allergy-btn__icon">✦</span>
        Yes, I have allergies
      </button>
      <form action="/allergies" method="POST" style="width:100%;">
        <input type="hidden" name="has_allergies" value="no" />
        <button type="submit" class="allergy-btn allergy-btn--no">
          <span class="allergy-btn__icon">◈</span>
          No allergies
        </button>
      </form>
    </div>

    <!-- Hidden allergy input, shown when "Yes" is clicked -->
    <form action="/allergies" method="POST" id="allergy-form" class="allergy-form" style="display:none;">
      <input type="hidden" name="has_allergies" value="yes" />
      <div class="form__group">
        <label class="form__label" for="allergy_detail">Please describe your allergies</label>
        <textarea
          class="form__input form__textarea"
          id="allergy_detail"
          name="allergy_detail"
          placeholder="e.g. Nuts, shellfish, gluten…"
          rows="3"
          required
        ></textarea>
      </div>
      <button type="submit" class="btn btn--gold btn--full">Continue →</button>
    </form>

  </div>
</main>

<footer class="site-footer">
  <p>Katlego &amp; Karabo · The Grand 21st Soirée</p>
</footer>

<script src="/js/app.js"></script>
<script>
  function showAllergyInput() {
    document.querySelector('.allergy-choices').style.display = 'none';
    document.getElementById('allergy-form').style.display = 'block';
    document.getElementById('allergy_detail').focus();
  }
</script>
</body>
</html>
